generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  DINE_IN
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  OPEN
  HELD
  PAID
  VOID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  phone       String?
  email       String?
  website     String?
  address     String?
  city        String?
  country     String?  @default("Pakistan")
  logoUrl     String?
  currency    String   @default("PKR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branches    Branch[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  phone          String?
  address        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  users          User[]
  categories     Category[]
  menuItems      MenuItem[]
  deals          Deal[]
  tables         DiningTable[]
  orderTakers    OrderTaker[]
  orders         Order[]
  shifts         Shift[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  system      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  group       String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model User {
  id           String   @id @default(cuid())
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  pinHash      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  roles        UserRole[]
  cashierOrders Order[] @relation("CashierOrders")
  auditLogs    AuditLog[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Category {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  imageUrl  String?
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Decimal  @db.Decimal(12,2)
  imageUrl    String?
  soldOut     Boolean  @default(false)
  active      Boolean  @default(true)
  sort        Int      @default(0)
  modifiers   Modifier[]
  orderLines  OrderLine[]
}

model Modifier {
  id        String   @id @default(cuid())
  itemId    String
  item      MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal  @db.Decimal(12,2)
  active    Boolean  @default(true)
}

model Deal {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal  @db.Decimal(12,2)
  imageUrl    String?
  active      Boolean  @default(true)
  sort        Int      @default(0)
  items       DealItem[]
  orderLines  OrderLine[]
}

model DealItem {
  id       String @id @default(cuid())
  dealId   String
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  itemId   String
  qty      Int
}

model DiningTable {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  seats     Int      @default(4)
  floor     String?  @default("Ground Floor")
  sort      Int      @default(0)
  active    Boolean  @default(true)
  orders    Order[]
}

model OrderTaker {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name     String
  active   Boolean @default(true)
  orders   Order[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String?
  mobile    String?
  address   String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Shift {
  id            String      @id @default(cuid())
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashierId     String
  openingCash   Decimal     @db.Decimal(12,2) @default(0)
  countedCash   Decimal?    @db.Decimal(12,2)
  cashDifference Decimal?   @db.Decimal(12,2)
  status        ShiftStatus @default(OPEN)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  orders        Order[]
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  branchId         String
  branch           Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type             OrderType
  status           OrderStatus @default(OPEN)
  tableId          String?
  table            DiningTable? @relation(fields: [tableId], references: [id])
  tableOccupiedAt  DateTime?
  guests           Int?
  orderTakerId     String?
  orderTaker       OrderTaker? @relation(fields: [orderTakerId], references: [id])
  customerId       String?
  customer         Customer?   @relation(fields: [customerId], references: [id])
  cashierId        String
  cashier          User        @relation("CashierOrders", fields: [cashierId], references: [id])
  shiftId          String?
  shift            Shift?      @relation(fields: [shiftId], references: [id])
  subtotal         Decimal     @db.Decimal(12,2) @default(0)
  discountType     String?
  discountValue    Decimal?    @db.Decimal(12,2)
  discountAmount   Decimal     @db.Decimal(12,2) @default(0)
  deliveryFee      Decimal     @db.Decimal(12,2) @default(0)
  total            Decimal     @db.Decimal(12,2) @default(0)
  paidAt           DateTime?
  voidedAt         DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  lines            OrderLine[]
  payments         Payment[]
  refunds          Refund[]
}

model OrderLine {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId     String?
  item       MenuItem? @relation(fields: [itemId], references: [id])
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id])
  name       String
  categoryName String?
  qty        Int
  price      Decimal  @db.Decimal(12,2)
  notes      String?
  createdAt  DateTime @default(now())
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12,2)
  received  Decimal?      @db.Decimal(12,2)
  change    Decimal       @db.Decimal(12,2) @default(0)
  reference String?
  createdAt DateTime      @default(now())
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12,2)
  method    String
  reason    String
  createdAt DateTime @default(now())
}

model ReceiptSettings {
  id          String   @id @default(cuid())
  branchId    String   @unique
  width       String   @default("80mm")
  copies      Int      @default(1)
  showLogo    Boolean  @default(true)
  headerText  String?
  footerText  String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}
