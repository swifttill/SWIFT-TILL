# SwiftTill POS V9 production environment
NODE_ENV=development
PORT=5174

# Local fallback runs without DATABASE_URL. Production requires Neon PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# Auth/session
SESSION_SECRET=change-this-long-random-secret
JWT_SECRET=change-this-long-random-secret
SESSION_TTL_MS=43200000

# Seed account override optional
ADMIN_SEED_EMAIL=admin@swifttill.local
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_NAME=Admin

# Cloudflare R2 image storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=swifttill-media
R2_PUBLIC_URL=https://media.example.com
R2_REGION=auto

# Local print agent
LOCAL_PRINT_AGENT_URL=http://127.0.0.1:9721/print
PRINT_AGENT_SECRET=change-this-local-print-secret

# Deployment
APP_PUBLIC_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174
