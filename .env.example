# SwiftTill POS V8 environment
NODE_ENV=development
PORT=5174
APP_URL=http://localhost:5174
API_URL=http://localhost:5174

# Local test mode still uses JSON until Neon is connected.
STORAGE_MODE=local-json

# Neon PostgreSQL production database
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# Auth/session
JWT_SECRET=change-this-to-a-long-random-secret
SESSION_SECRET=change-this-to-a-long-random-secret
ADMIN_SEED_EMAIL=admin@swifttill.local
ADMIN_SEED_PASSWORD=admin123
ADMIN_MANAGER_PIN=1234

# Cloudflare R2 image storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=swifttill-media
R2_PUBLIC_URL=https://media.example.com
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Local thermal print agent
PRINT_AGENT_URL=http://127.0.0.1:9721/print
PRINT_AGENT_TOKEN=change-this-local-print-token
