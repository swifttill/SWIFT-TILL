# SwiftTill POS V24 production environment
NODE_ENV=development
PORT=5174

# Production requires Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
SWIFTTILL_DATA_STORE=postgres
SWIFTTILL_STATE_KEY=swift-till-main

# Auth/session
SESSION_SECRET=change-this-long-random-secret
JWT_SECRET=change-this-long-random-secret
SESSION_TTL_MS=43200000

# Bootstrap account. Change password immediately after first login.
ADMIN_SEED_EMAIL=admin@swifttill.local
ADMIN_SEED_PASSWORD=change-this-before-client-use
ADMIN_SEED_NAME=Admin

# Cloudflare R2 image/backups storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=swifttill-media
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
MAX_IMAGE_MB=5

# Cloud print queue for client print agent
SWIFTTILL_PRINT_AGENT_KEY=change-this-private-print-agent-key

# Client browser fallback/local agent URL
LOCAL_PRINT_AGENT_URL=http://127.0.0.1:9721/print

# Deployment
APP_PUBLIC_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174
