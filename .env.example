PORT=5174
NODE_ENV=development

# Local default uses JSON database under data/db.json.
LOCAL_DB_PATH=data/db.json

# Production database later.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# Cloudflare R2 later.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Security later.
JWT_SECRET=change-this-before-production
ADMIN_SEED_EMAIL=admin@swifttill.local
ADMIN_SEED_PASSWORD=change-this-before-production

# Future local printer agent.
PRINT_AGENT_URL=http://127.0.0.1:9174
PRINT_AGENT_TOKEN=
